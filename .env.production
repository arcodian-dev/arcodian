VITE_ENABLE_V5_TESTNET_DEPLOY=false
VITE_V5_DEPLOYER=0x7D9b5ab14b24Dede3b78b7e1715C1E01032F40C2
VITE_V5_TREASURY=0xF1CBe360b45F2E22Ab74A2c434e5602f66105CaF
VITE_PUBLIC_ORIGIN=https://arcodian.fun
# WalletConnect (mobile wallets): register a free project at https://cloud.reown.com,
# paste the Project ID below, then rebuild + release. The "Scan with WalletConnect"
# button stays hidden while this is empty (fail-closed).
VITE_WALLETCONNECT_PROJECT_ID=

# Arc Mainnet RPC: blockdaemon's public endpoint (rpc.blockdaemon.mainnet.arc.io)
# started returning 401 Unauthorized 2026-07-31. thirdweb's edge recognizes
# chain 5042 but needs a client ID (https://thirdweb.com/dashboard -> create
# project -> RPC Edge). Paste it below, then rebuild + release to switch the
# whole app (bridge, wallet, claim) off the 401ing RPC. Empty = falls back to
# the blockdaemon URL (currently broken) so nothing silently points nowhere.
VITE_THIRDWEB_CLIENT_ID=

VITE_SUBDOMAINS_LIVE=true
