[Unit]
Description=Arc Mainnet one-second live trade tape
# Deliberately NOT After=arcodian-mainnet-index.service (removed 2026-08-30):
# that unit now runs every 30s and, once healthy, is rarely fully idle, so a
# strict ordering dependency queued this unit's start job behind it
# indefinitely — a restart never actually happened. The tape script already
# tolerates a missing/stale index file (reads it in a try/catch), so the
# ordering was never load-bearing.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/arc
Environment=MAINNET_INDEX_PATH=/www/wwwroot/arcodian.fun/shared/data/mainnet-market-index.json
Environment=MAINNET_TAPE_OUTPUT=/www/wwwroot/arcodian.fun/shared/data/mainnet-live-tape.json
# ARC_MAINNET_RPC_URL (a comma-separated fallback list — see the script's
# own comment) lives in /root/.config/arcodian/mainnet-tape-rpc.env, split
# off 2026-09-12 from the shared mainnet-rpc.env: this unit calls RPC
# endpoints directly (with in-script rotation on failure) rather than
# through the same-origin proxy the other mainnet services use, because
# the proxy's extra HTTP hop was slow enough to blow this unit's own 30s
# per-tick timeout during venue-discovery bootstrap. Not committed here —
# same reasoning as before: kept out of the tracked file on principle even
# though these particular URLs are public, so this pattern doesn't quietly
# regress if a future edit swaps one back to a gated endpoint.
EnvironmentFile=/root/.config/arcodian/mainnet-tape-rpc.env
ExecStart=/usr/bin/node scripts/mainnet-live-tape.mjs
# ExecStartPost cp removed 2026-08-30: current/data is a symlink straight to
# shared/data (see DEPLOYMENT.md), so this had become a same-file copy —
# `cp` refuses that with "are the same file" (exit 1), which failed the
# whole unit's start and crash-looped it every 2s (RestartSec) from the
# moment current/data became that symlink until this fix, unnoticed because
# the previous long-lived process (started before the symlink existed) kept
# running throughout and never needed to restart.
Restart=always
RestartSec=2s
User=root
Group=root
Nice=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
