[Unit]
Description=Verify and append-export the Arcodian MCP audit chain
After=arcodian-mcp.service

[Service]
Type=oneshot
WorkingDirectory=/root/.openclaw/workspace/arc
Environment=MCP_STATE_DB=/var/lib/arcodian-mcp/state.db
Environment=MCP_AUDIT_EXPORT=/var/lib/arcodian-mcp/audit-export.ndjson
ExecStart=/usr/bin/node scripts/mcp-audit-export.mjs
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arcodian-mcp
