[Unit]
Description=Arcodian AgentRail public provider server (keyless voucher-gated inference)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/arc
Environment=ARC_RPC_URL=https://rpc.drpc.testnet.arc.io
Environment=PAY_VAULT_ADDRESS=0xD6bC439615D6fc2EA8cD6eC6CAC413E8F7e85dD1
Environment=PROVIDER_ADDRESS=0xd84881BC301C19FD917AE24741Df6255f58bf342
Environment=SERVICE_PRICE_USDC=0.01
Environment=VOUCHER_STORE=/var/lib/arcodian/agentrail-vouchers.json
Environment=SERVE_PORT=8795
Environment=ARCODIAN3_BASE_URL=http://localhost:8081/v1
Environment=ARCODIAN3_UPSTREAM=arcodian-3-internal
ExecStart=/usr/bin/node scripts/agentrail-provider-serve.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
