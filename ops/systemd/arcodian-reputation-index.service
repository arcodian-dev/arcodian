[Unit]
Description=Arcodian ERC-8004 reputation aggregator (Phase C)
After=network-online.target arcodian-job-index.service
Wants=arcodian-job-index.service
[Service]
Type=oneshot
WorkingDirectory=/root/.openclaw/workspace/arc
Environment=ARC_RPC_URL=https://rpc.testnet.arc.network/
Environment=JOB_INDEX_OUT=/www/wwwroot/arcodian.fun/shared/developers/jobs.json
Environment=REPUTATION_INDEX_OUT=/www/wwwroot/arcodian.fun/shared/developers/reputation.json
ExecStart=/usr/bin/node scripts/reputation-index.mjs
ExecStartPost=/bin/chown www:www /www/wwwroot/arcodian.fun/shared/developers/reputation.json
