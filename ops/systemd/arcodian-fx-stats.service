[Unit]
Description=Arcodian FX pool stats indexer
After=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/root/.openclaw/workspace/arc
Environment=ARC_RPC_URL=https://rpc.testnet.arc.network/
Environment=FX_STATS_OUTPUT=/www/wwwroot/arcodian.fun/shared/data/fx-stats.json
Environment=FX_DEPLOY_BLOCK=52457238
Environment=ARC_FX_POOL=0x982D61ddCAb6169d82B3e37A4E4158f1982E5447
ExecStart=/usr/bin/node scripts/fx-stats.mjs
TimeoutStartSec=600
